    "dialogues": [
      {
        "id": "A01",
        "actor": "lumiere",
        "text": "シ……オンさま……\nシオンさま！",
        "time": 648.4000000059605
      },
      {
        "id": "A02",
        "actor": "shion",
        "text": "……リュミエール？",
        "time": 10821
      },
      {
        "id": "A03",
        "actor": "shiopon",
        "text": "シオンさま、大丈夫ぴょん？\nずっと呼んでたぴょん……",
        "time": 21131.40000000596
      },
      {
        "id": "A04",
        "actor": "shion",
        "text": "今のは……\n……いや。今は、それより――",
        "time": 27237.10000000894
      },
      {
        "id": "A05",
        "actor": "shiopon",
        "text": "……初めて、食べられたの。",
        "time": 34110
      },
      {
        "id": "A06",
        "actor": "shiopon",
        "text": "星の声が……食べられたの。",
        "time": 40840.90000000596
      },
      {
        "id": "A07",
        "actor": "shion",
        "text": "食べられた？",
        "time": 44847.90000000596
      },
      {
        "id": "A08",
        "actor": "lumiere",
        "text": "……私にも、初めての事で。",
        "time": 51356.79999999702
      },
      {
        "id": "A09",
        "actor": "lumiere",
        "text": "少なくとも、安全を確かめるまでは星門は使わない方がよさそうです。",
        "time": 56620.10000000894
      },
      {
        "id": "A10",
        "actor": "lumiere",
        "text": "アリエット様なら、きっと原因がわかるかもしれません。",
        "time": 61517.10000000894
      },
      {
        "id": "A11",
        "actor": "shion",
        "text": "……そうだな。\nアリエットに相談しよう。",
        "time": 67128.20000000298
      },
      {
        "id": "A12",
        "actor": "lumiere",
        "text": "では、私は先に星砂の準備をしてきます。\nお二人は、東側から来てください。",
        "time": 76605.70000000298
      },
      {
        "id": "A13",
        "actor": "shion",
        "text": "分かった。頼む。",
        "time": 88242.90000000596
      },
      {
        "id": "A14",
        "actor": "shiopon",
        "text": "リュミエール、またあとでね。",
        "time": 96322.70000000298
      }
